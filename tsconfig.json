  // apps/web no está acá a propósito. Su compilación la hace Next, con otro
  // objetivo de módulos y con JSX.
  "files": [],
  "references": [
    { "path": "./packages/domain" },
    { "path": "./packages/catalog" },
    { "path": "./packages/db" },
    { "path": "./packages/core" },
    { "path": "./packages/crm" },
    { "path": "./packages/design" },
    { "path": "./packages/ai" },
    { "path": "./packages/sales" }
  ]
}
