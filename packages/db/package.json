{
  "name": "@nci/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esquema del grafo de conocimiento sobre PostgreSQL.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --import tsx src/check.ts",
    "generate": "drizzle-kit generate",
    "migrate": "node --import tsx src/migrate.ts",
    "seed": "node --import tsx src/seed.ts",
    "test": "node ../../scripts/correr.mjs \"src/**/!(*.integration).test.ts\" -- --import tsx"
  },
  "dependencies": {
    "@nci/domain": "*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
