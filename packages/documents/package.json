{
  "name": "@nci/documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Los documentos que NCI le entrega a un cliente. Hoy, el presupuesto en PDF.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/correr.mjs \"src/**/!(*.integration).test.ts\" -- --import tsx"
  },
  "dependencies": {
    "@nci/domain": "*",
    "pdfkit": "^0.15.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.9"
  }
}
