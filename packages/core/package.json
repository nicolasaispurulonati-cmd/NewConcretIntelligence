{
  "name": "@nci/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El motor de NewConcret Intelligence: autorización, grafo, actividad y búsqueda universal.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "set-password": "node --import tsx src/scripts/set-password.ts",
    "test": "node --import tsx --test \"src/**/!(*.integration).test.ts\"",
    "test:integracion": "node --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@nci/db": "*",
    "@nci/domain": "*",
    "drizzle-orm": "^0.44.5"
  }
}
