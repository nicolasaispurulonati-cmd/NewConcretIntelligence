# ─────────────────────────────────────────────────────────────
# NewConcret Intelligence — variables de entorno
#
# Copiar a .env en la raíz del proyecto y completar. El .env nunca se versiona.
# ─────────────────────────────────────────────────────────────

# Base de datos: PostgreSQL 16+ con las extensiones vector, pg_trgm y unaccent.
#
# El valor de abajo coincide con docker-compose.yml, que levanta la base local
# ya lista con pgvector. Para producción va la cadena del servicio gestionado,
# normalmente con ?sslmode=require al final.
DATABASE_URL="postgresql://nci:desarrollo_local@localhost:5432/nci"

# AI Engine.
# Sin clave la plataforma funciona completa salvo el asistente.
# Se obtiene en console.anthropic.com
ANTHROPIC_API_KEY=""
NCI_AI_MODEL="claude-opus-5"

# Sesiones. Generar una propia por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NCI_SESSION_SECRET=""

# Puente on-premise hacia Tango.
# El puente corre en la red interna de NewConcret y sale hacia la nube;
# la nube nunca inicia conexiones hacia adentro. Ver docs/08-technical-architecture.md
NCI_BRIDGE_SHARED_SECRET=""
