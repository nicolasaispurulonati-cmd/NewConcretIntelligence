# ─────────────────────────────────────────────────────────────
# NewConcret Intelligence — variables de entorno
#
# Copiar a .env en la raíz del proyecto. El .env nunca se versiona; esta
# plantilla sí, y por eso no lleva ningún valor real.
#
# El archivo se busca hacia arriba desde donde corra cada script, así que uno
# solo en la raíz alcanza para todos los paquetes y para la aplicación web.
# ─────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────

# OBLIGATORIA. Conexión a PostgreSQL 17, con las extensiones vector, pg_trgm y
# unaccent disponibles. La versión importa: una prueba que corre contra otra
# versión valida otro sistema.
#
# Para la base de desarrollo (npm run db:local):
#
#   postgresql://postgres:postgres@127.0.0.1:5432/postgres
#
# En Windows conviene 127.0.0.1 y no localhost: localhost resuelve primero a
# IPv6, y ninguna de las dos escucha ahí.
#
# Para producción, la cadena del servicio gestionado, normalmente terminada
# en ?sslmode=require
#
# En Neon hay dos cadenas y no son intercambiables. La aplicación usa la del
# endpoint con "-pooler" en el host: reparte muchas conexiones efímeras sobre
# pocas reales, que es lo que necesita el serverless. Las migraciones usan la
# directa, sin "-pooler": ver DATABASE_URL_DIRECTA más abajo.
#
# Si la cadena copiada trae channel_binding, se puede dejar: el cliente lo quita
# antes de conectar porque el servidor rechazaría la conexión entera.
DATABASE_URL=""

# OBLIGATORIA sólo en producción, y sólo donde corren las migraciones.
#
# La misma base por el endpoint directo, sin "-pooler". Un pooler en modo
# transacción puede repartir cada sentencia en una sesión distinta, y una
# migración necesita que el lock de tabla que toma al principio siga vivo al
# final. La aplicación nunca lee esta variable.
DATABASE_URL_DIRECTA=""

# Opcionales. Ajustes del pool de conexiones.
#
# Los valores por defecto ya son los correctos en los dos entornos, así que
# normalmente van vacíos:
#
#   Docker o PostgreSQL real   10 conexiones, sin cierre por inactividad
#   Vercel u otro serverless    1 conexión por instancia, cierre a los 20 s
#
# Un valor puesto acá gana siempre. Un pool de 1 sobre un servidor real
# serializa todas las consultas y la aplicación vuelve a bloquear las
# migraciones. npm run db:check lo avisa.
NCI_DB_POOL_MAX=""
NCI_DB_IDLE_TIMEOUT=""

# Opcional. Segundos antes de abandonar el intento de conexión. Por defecto 10.
# El valor de fábrica del driver son 30, más de lo que dura una función
# serverless: el request moriría esperando sin devolver ningún error.
NCI_DB_CONNECT_TIMEOUT=""

# Opcional. Forzar el perfil de conexión de entorno serverless.
#
# Se detecta solo en Vercel. Poner "1" sirve para otra plataforma de funciones
# efímeras, donde cada instancia abre su propio pool y un pool grande multiplica
# las conexiones hasta agotar el límite del proveedor.
NCI_DB_SERVERLESS=""


# ─────────────────────────────────────────────────────────────
# Motor de IA
# ─────────────────────────────────────────────────────────────

# Opcional. Sin ella la plataforma funciona completa salvo el asistente.
# La lee el SDK de Anthropic, no el código de NCI. Se obtiene en
# console.anthropic.com
ANTHROPIC_API_KEY=""

# Opcional. Modelo que usa el asistente. Por defecto claude-opus-5.
NCI_AI_MODEL=""


# ─────────────────────────────────────────────────────────────
# Scripts de puesta en marcha
#
# No hacen falta para que la plataforma funcione. Se usan una vez, al
# preparar un entorno, y pueden pasarse en la línea de comandos en lugar de
# dejarlas escritas acá.
# ─────────────────────────────────────────────────────────────

# Opcional. Correo del primer administrador que crea npm run db:seed.
# Sin ella la siembra carga los roles y no crea ningún usuario.
NCI_ADMIN_EMAIL=""

# Opcional. Nombre de ese primer administrador. Por defecto, su correo.
NCI_ADMIN_NAME=""

# Opcional, y desaconsejada en un archivo.
# npm run user:password pide la contraseña por consola sin mostrarla. Esta
# variable existe sólo para automatizaciones que no tienen consola; usarla acá
# deja la contraseña escrita en texto plano.
NCI_PASSWORD=""

# Clave del usuario que crea npm run demo:comercial.
#
# Obligatoria si la base no está en esta máquina, o si NODE_ENV es production.
# Contra una base local hay un valor por defecto, que está escrito en el
# repositorio y por eso no sirve en ningún otro lado: el script crea un usuario
# real con rol Comercial, y una clave pública para una cuenta real es una
# cuenta de cualquiera.
NCI_DEMO_PASSWORD=""


# ─────────────────────────────────────────────────────────────
# Identidad de NewConcret
#
# Es lo que aparece en la cabecera de todo documento que sale hacia un
# cliente. Vive en el entorno y no en la base ni en el código porque se
# configura una vez por despliegue y cambiar un teléfono no debería exigir una
# migración ni un commit. Ver D-018.
#
# Las cinco primeras son obligatorias para emitir un documento. Si falta
# alguna, la generación falla y dice cuáles faltan, en lugar de sacar un PDF
# con un CUIT en blanco. Ningún valor por defecto: un documento con datos
# inventados llega a un cliente, y eso no se deshace.
# ─────────────────────────────────────────────────────────────

NCI_EMPRESA_RAZON_SOCIAL=""
NCI_EMPRESA_CUIT=""
NCI_EMPRESA_DOMICILIO=""
NCI_EMPRESA_TELEFONO=""
NCI_EMPRESA_CORREO=""

# Opcional. Si está vacía, el documento no muestra la línea.
NCI_EMPRESA_WEB=""


# ─────────────────────────────────────────────────────────────
# Reservadas
#
# Declaradas para el dominio que viene. Hoy ningún código las lee.
# ─────────────────────────────────────────────────────────────

# Secreto compartido con el puente on-premise hacia Tango. El puente corre en
# la red interna de NewConcret y sale hacia la nube; la nube nunca inicia
# conexiones hacia adentro. Ver docs/08-technical-architecture.md
NCI_BRIDGE_SHARED_SECRET=""


# ─────────────────────────────────────────────────────────────
# NODE_ENV no va acá. La fija la herramienta que corre el proceso:
# "development" con npm run dev, "production" con next build y next start.
# ─────────────────────────────────────────────────────────────
