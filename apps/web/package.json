{
  "name": "@nci/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "tsc -b ../.. && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:integracion": "node ../../scripts/correr.mjs \"src/**/*.integration.test.ts\" --tsconfig tsconfig.pruebas.json -- --import tsx --conditions=react-server --test-concurrency=1",
    "test": "node ../../scripts/correr.mjs \"src/**/!(*.integration).test.ts\" --tsconfig tsconfig.pruebas.json -- --import tsx --conditions=react-server"
  },
  "dependencies": {
    "@nci/ai": "*",
    "@nci/catalog": "*",
    "@nci/core": "*",
    "@nci/crm": "*",
    "@nci/db": "*",
    "@nci/design": "*",
    "@nci/domain": "*",
    "@nci/sales": "*",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.3"
  }
}
